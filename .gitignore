# Compiled output
/dist
/tmp
/out-tsc

# Node
/node_modules
npm-debug.log
yarn-error.log

# Secrets (Supabase service key lives here, never in the frontend)
.env
.env.*
!.env.example

# Benchmark output (the history lives in Supabase)
/bench/out

# Supabase CLI
/supabase/.temp
/supabase/.branches

# Claude Code (per-machine settings, e.g. the vault path)
.claude/settings.local.json

# IDEs and editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/coverage
testem.log
__screenshots__/

# System files
.DS_Store
Thumbs.db
