{
  "name": "lidar-explorer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:core && npm run test:app",
    "test:core": "vitest run --config vitest.core.config.ts --coverage",
    "test:app": "ng test --watch=false",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.spec.json && tsc -p tsconfig.core.json && tsc -p tsconfig.core.spec.json && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:fast": "npm run typecheck && npm run lint && npm run test:core",
    "verify": "npm run format:check && npm run verify:fast && npm run test:app && npm run build"
  },
  "private": true,
  "packageManager": "npm@12.2.2",
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "26.x"
  },
  "type": "module"
}
